{{ define "email_shell_start" }}
<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="x-ua-compatible" content="ie=edge">
<meta name="color-scheme" content="light only">
<meta name="supported-color-schemes" content="light only">
<title>{{ .EmailTitle }}</title>
<!--[if mso]>
<noscript>
  <xml>
    <o:OfficeDocumentSettings>
      <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
  </xml>
</noscript>
<![endif]-->
<style>
  /* Ask clients that honor it (Apple Mail, Outlook for Mac) to keep the light design. All real
     styling is inline; this block only pins colors for clients that rewrite them in dark mode. */
  :root { color-scheme: light only; supported-color-schemes: light only; }
  [data-ogsc] .em-eyebrow { color: #e8c98a !important; }
  [data-ogsc] .em-title { color: #ffffff !important; }
  [data-ogsc] .em-cta { color: #1b140a !important; }
  [data-ogsb] .em-header { background-color: #1f3c63 !important; }
  [data-ogsb] .em-card { background-color: #fbf6ea !important; }
  [data-ogsb] .em-cta-cell, [data-ogsb] .em-cta { background-color: #e0b868 !important; }
</style>
</head>
<body style="margin:0;padding:0;background-color:#f1e9d6;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.55;color:#1b1812;-webkit-text-size-adjust:100%;">
{{ if .Preheader }}
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#f1e9d6;opacity:0;">
  {{ .Preheader }}&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
</div>
{{ end }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f1e9d6" style="background-color:#f1e9d6;">
  <tr>
    <td align="center" style="padding:36px 14px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="em-card" bgcolor="#fbf6ea" style="max-width:560px;width:100%;background-color:#fbf6ea;border:1px solid #e2d6b8;border-radius:14px;">
        <tr>
          <td class="em-header" bgcolor="#1f3c63" style="padding:26px 32px 22px;background-color:#1f3c63;border-bottom:4px solid #b08745;border-radius:13px 13px 0 0;">
            <p class="em-eyebrow" style="margin:0 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#e8c98a;line-height:1.3;">
              {{ .Eyebrow }}
            </p>
            <h1 class="em-title" style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:26px;font-weight:normal;line-height:1.25;color:#ffffff;">
              {{ .Headline }}
            </h1>
          </td>
        </tr>
        <tr>
          <td style="padding:28px 32px 4px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.6;color:#1b1812;">
{{ end }}

{{ define "email_shell_end" }}
          </td>
        </tr>
        <tr>
          <td style="padding:8px 32px 26px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="border-top:1px solid #e2d6b8;padding-top:18px;">
                  <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.55;color:#5b554a;">
                    {{ .FooterNote }}
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
      <p style="margin:18px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.5;color:#5b554a;text-align:center;max-width:560px;">
        {{ .SiteLabel }} Mission Plan &middot; For local ward use
      </p>
    </td>
  </tr>
</table>
</body>
</html>
{{ end }}

{{ define "email_detail_row" }}
<tr>
  <td style="padding:0 0 12px;">
    <p style="margin:0 0 2px;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#5b554a;">{{ .Label }}</p>
    <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.45;color:#1b1812;">{{ .Value }}</p>
  </td>
</tr>
{{ end }}

{{ define "email_cta_button" }}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:26px 0 8px;">
  <tr>
    <td class="em-cta-cell" align="center" bgcolor="#e0b868" style="border-radius:10px;background-color:#e0b868;border:1px solid #b08745;">
      <!--[if mso]>
      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ .CTAURL }}" style="height:48px;v-text-anchor:middle;width:260px;" arcsize="18%" strokecolor="#b08745" fillcolor="#e0b868">
        <w:anchorlock/>
        <center style="color:#1b140a;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;">{{ .CTALabel }}</center>
      </v:roundrect>
      <![endif]-->
      <!--[if !mso]><!-->
      <a class="em-cta" href="{{ .CTAURL }}" target="_blank" style="display:inline-block;padding:14px 28px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:700;line-height:1.25;color:#1b140a;text-decoration:none;border-radius:10px;background-color:#e0b868;">
        {{ .CTALabel }} &rarr;
      </a>
      <!--<![endif]-->
    </td>
  </tr>
</table>
{{ end }}
