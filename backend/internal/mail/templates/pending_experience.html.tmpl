{{ template "email_shell_start" . }}
            <p style="margin:0 0 18px;font-size:17px;line-height:1.6;color:#1b1812;">
              A ward member shared a missionary experience. It is waiting for a leader to review it before it appears on the site.
            </p>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#fffdf6" style="margin:0 0 16px;background-color:#fffdf6;border:1px solid #e2d6b8;border-left:4px solid #b08745;border-radius:10px;">
              <tr>
                <td style="padding:16px 20px 4px;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    {{ template "email_detail_row" (detail "From" .AuthorLabel) }}
                    {{ template "email_detail_row" (detail "Submitted" .SubmittedAt) }}
                  </table>
                </td>
              </tr>
            </table>
            <p style="margin:0 0 6px;font-size:12px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#5b554a;">Their story</p>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#fffdf6" style="margin:0 0 4px;background-color:#fffdf6;border:1px solid #e2d6b8;border-radius:10px;">
              <tr>
                <td style="padding:16px 20px;font-family:Georgia,'Times New Roman',serif;font-size:16px;line-height:1.6;color:#1b1812;white-space:pre-wrap;word-break:break-word;">{{ .BodyPreview }}</td>
              </tr>
            </table>
            {{ template "email_cta_button" . }}
            <p style="margin:14px 0 0;font-size:14px;line-height:1.5;color:#5b554a;">
              Or copy this link:<br>
              <a href="{{ .ModerateURL }}" style="color:#1f3c63;word-break:break-all;">{{ .ModerateURL }}</a>
            </p>
{{ template "email_shell_end" . }}
