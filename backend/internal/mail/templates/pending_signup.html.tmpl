{{ template "email_shell_start" . }}
            <p style="margin:0 0 18px;font-size:17px;line-height:1.6;color:#1b1812;">
              <strong>{{ .RequesterDisplayName }}</strong> asked for access to the ward leader tools (reviewing experiences, editing the ward plan, and approving leaders).
            </p>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#fffdf6" style="margin:0 0 4px;background-color:#fffdf6;border:1px solid #e2d6b8;border-left:4px solid #b08745;border-radius:10px;">
              <tr>
                <td style="padding:16px 20px 4px;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    {{ template "email_detail_row" (detail "Name" .RequesterDisplayName) }}
                    {{ template "email_detail_row" (detail "Email" .RequesterEmail) }}
                    {{ template "email_detail_row" (detail "Requested" .RequestedAt) }}
                  </table>
                </td>
              </tr>
            </table>
            <p style="margin:14px 0 0;font-size:15px;line-height:1.55;color:#3d382f;">
              If you know this person and they serve in a ward calling, approve them. Otherwise you can deny the request.
            </p>
            {{ template "email_cta_button" . }}
            <p style="margin:14px 0 0;font-size:14px;line-height:1.5;color:#5b554a;">
              Or copy this link:<br>
              <a href="{{ .ApprovalsURL }}" style="color:#1f3c63;word-break:break-all;">{{ .ApprovalsURL }}</a>
            </p>
{{ template "email_shell_end" . }}
